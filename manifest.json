{
  "manifest_version": 3,
  "name": "Browser Companion Pet",
  "version": "1.0.0",
  "description": "An adorable virtual pet that walks around your web pages, reacts to clicks, and follows your cursor.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Browser Companion Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["pet.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.svg",
        "assets/*.png",
        "pet.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
